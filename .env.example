# Copy this file to .env (same directory as docker-compose.yaml) and fill in
# real values. Docker Compose loads .env automatically.

# Required: the Signal number registered/linked in signal-cli-rest-api.
SIGNAL_NUMBER=+15551234567

# Optional: if set, every request to signal-mcp-server must include
# "Authorization: Bearer <this value>". Leave empty while everything stays
# on 127.0.0.1; set it before exposing the port any wider.
MCP_AUTH_TOKEN=

# Optional: debug | info | warn | error
LOG_LEVEL=info
